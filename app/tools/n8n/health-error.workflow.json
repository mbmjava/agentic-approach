{
  "id": "healthwatch00001",
  "name": "health - workflow error watcher",
  "nodes": [
    {
      "id": "errtrigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "build",
      "name": "Build event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Normalise an n8n error payload into the platform-neutral event.\nconst e = $json || {};\nconst wf = (e.workflow && e.workflow.name) || e.workflowName || 'unknown';\nconst exec = e.execution || {};\nconst url = exec.url || '';\nconst node = exec.lastNodeExecuted || '';\nconst err = (exec.error && (exec.error.message || exec.error.description)) || (e.error && e.error.message) || 'unknown error';\nconst text = 'Workflow error: ' + wf + '\\nNode: ' + node + '\\nError: ' + err;\nreturn [{ json: { channel: 'none', event: 'workflow-error', escalate: true, title: 'Error in ' + wf, text, url } }];"
      }
    },
    {
      "id": "dispatch",
      "name": "Dispatch notification",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        440,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_NOTIFY_ID",
          "mode": "list",
          "cachedResultName": "notify - channel adapters (swap point)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "={{ $json.channel }}",
            "event": "={{ $json.event }}",
            "escalate": "={{ $json.escalate }}",
            "title": "={{ $json.title }}",
            "text": "={{ $json.text }}",
            "url": "={{ $json.url }}"
          }
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build event": {
      "main": [
        [
          {
            "node": "Dispatch notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}