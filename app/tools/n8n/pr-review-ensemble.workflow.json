{
  "id": "ensemblereview01",
  "name": "PR review ENSEMBLE - GitHub adapter",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "sched",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/OWNER/REPO/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "state",
              "value": "open"
            },
            {
              "name": "per_page",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "id": "list",
      "name": "List open PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_GITHUB_CRED_ID",
          "name": "Github"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nconst reviewed = store.reviewed || {};\nconst out = [];\nfor (const item of $input.all()) { const pr = item.json; if (reviewed[String(pr.number)] === pr.head.sha) continue; out.push({ json: pr }); }\nreturn out;"
      },
      "id": "dedup",
      "name": "Dedup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/OWNER/REPO/pulls/{{ $json.number }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.v3.diff"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "id": "diff",
      "name": "Get PR diff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_GITHUB_CRED_ID",
          "name": "Github"
        }
      }
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_JUDGE_ID",
          "mode": "list",
          "cachedResultName": "judge - multi-model review (provider-neutral)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "diff": "={{ $json.data }}",
            "models": "openai/gpt-6-luna,openai/gpt-6-luna,openai/gpt-6-luna"
          }
        },
        "options": {},
        "mode": "each"
      },
      "id": "judge-call",
      "name": "Judge",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/OWNER/REPO/issues/{{ $('List open PRs').item.json.number }}/comments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ body: $json.comment }) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "id": "comment",
      "name": "Post review comment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_GITHUB_CRED_ID",
          "name": "Github"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const c = $('Judge').item.json;\nconst sha = $('List open PRs').item.json.head.sha;\nconst state = c.verdict === 'request-changes' ? 'failure' : c.disagreement ? 'pending' : 'success';\nconst desc = c.disagreement ? 'escalated: judges disagreed' : ('verdict: ' + c.verdict);\nreturn [{ json: { sha, escalate: !!c.disagreement, body: { state, context: 'n8n-reviewer', description: desc.slice(0, 140) } } }];",
        "mode": "runOnceForEachItem"
      },
      "id": "bstatus",
      "name": "Build commit status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/OWNER/REPO/statuses/{{ $json.sha }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth"
      },
      "id": "sstatus",
      "name": "Set commit status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_GITHUB_CRED_ID",
          "name": "Github"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const pr = $('List open PRs').item.json;\nconst c = $('Judge').item.json;\nconst text = 'PR #' + pr.number + ' ' + pr.title + '\\nVerdict: ' + c.verdict + (c.disagreement ? ' (disagreement)' : '') + '\\nJudges: ' + c.judgeCount;\nreturn [{ json: { channel: 'none', event: c.disagreement ? 'pr-review-escalation' : 'pr-review', escalate: !!c.disagreement, title: 'PR #' + pr.number, text, url: pr.html_url, verdict: c.verdict } }];",
        "mode": "runOnceForEachItem"
      },
      "id": "digest",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_NOTIFY_ID",
          "mode": "list",
          "cachedResultName": "notify - channel adapters (swap point)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "={{ $json.channel }}",
            "event": "={{ $json.event }}",
            "escalate": "={{ $json.escalate }}",
            "title": "={{ $json.title }}",
            "text": "={{ $json.text }}",
            "url": "={{ $json.url }}"
          }
        },
        "options": {},
        "mode": "each"
      },
      "id": "notify",
      "name": "Notify (swap point)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1980,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.reviewed = store.reviewed || {};\nfor (const item of $input.all()) { const pr = $('List open PRs').item.json; store.reviewed[String(pr.number)] = pr.head.sha; }\nreturn $input.all();"
      },
      "id": "mark",
      "name": "Mark reviewed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "List open PRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List open PRs": {
      "main": [
        [
          {
            "node": "Dedup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dedup": {
      "main": [
        [
          {
            "node": "Get PR diff",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get PR diff": {
      "main": [
        [
          {
            "node": "Judge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Judge": {
      "main": [
        [
          {
            "node": "Post review comment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post review comment": {
      "main": [
        [
          {
            "node": "Build commit status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build commit status": {
      "main": [
        [
          {
            "node": "Set commit status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set commit status": {
      "main": [
        [
          {
            "node": "Build digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build digest": {
      "main": [
        [
          {
            "node": "Notify (swap point)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify (swap point)": {
      "main": [
        [
          {
            "node": "Mark reviewed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}